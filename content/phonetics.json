  "vowels": [
    {
      "id": "a-short",
      "pattern": "-ะ / -ั-",
      "ipa": "a",
      "length": "短",
      "example": "กะ",
      "exampleIPA": "kàʔ",
      "zh": "估量；估计",
      "note": "有韵尾时常改写为 -ั-，如 กัน。"
    },
    {
      "id": "a-long",
      "pattern": "-า",
      "ipa": "aː",
      "length": "长",
      "example": "กา",
      "exampleIPA": "kaː",
      "zh": "乌鸦",
      "note": "与短 /a/ 区别在时长。"
    },
    {
      "id": "i-short",
      "pattern": "-ิ",
      "ipa": "i",
      "length": "短",
      "example": "กิน",
      "exampleIPA": "kin",
      "zh": "吃",
      "note": "上方元音；韵尾 น 使该音节为舒声。"
    },
    {
      "id": "i-long",
      "pattern": "-ี",
      "ipa": "iː",
      "length": "长",
      "example": "ดี",
      "exampleIPA": "diː",
      "zh": "好",
      "note": "不要把长短区别只理解成音量。"
    },
    {
      "id": "ue-short",
      "pattern": "-ึ",
      "ipa": "ɯ",
      "length": "短",
      "example": "นึก",
      "exampleIPA": "nɯ́k̚",
      "zh": "想起",
      "note": "高后不圆唇元音；嘴唇不撮圆。"
    },
    {
      "id": "ue-long",
      "pattern": "-ือ / -ื-",
      "ipa": "ɯː",
      "length": "长",
      "example": "มือ",
      "exampleIPA": "mɯː",
      "zh": "手",
      "note": "开音节常写 -ือ；有韵尾时如 คืน。"
    },
    {
      "id": "u-short",
      "pattern": "-ุ",
      "ipa": "u",
      "length": "短",
      "example": "ขุด",
      "exampleIPA": "kʰùt̚",
      "zh": "挖",
      "note": "下方元音。"
    },
    {
      "id": "u-long",
      "pattern": "-ู",
      "ipa": "uː",
      "length": "长",
      "example": "ดู",
      "exampleIPA": "duː",
      "zh": "看",
      "note": "注意与短 /u/ 对比。"
    },
    {
      "id": "e-short",
      "pattern": "เ-ะ / เ-็-",
      "ipa": "e",
      "length": "短",
      "example": "เด็ก",
      "exampleIPA": "dèk̚",
      "zh": "儿童",
      "note": "有韵尾时常写 เ-็-，并非所有词都显式标短。"
    },
    {
      "id": "e-long",
      "pattern": "เ-",
      "ipa": "eː",
      "length": "长",
      "example": "เท",
      "exampleIPA": "tʰeː",
      "zh": "倒；倾倒",
      "note": "元音符号写在辅音前，发音仍在辅音之后。"
    },
    {
      "id": "ae-short",
      "pattern": "แ-ะ / แ-็-",
